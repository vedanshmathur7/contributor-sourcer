# ---------- Backend ----------
# Fine-grained GitHub token, "Public repositories (read-only)" access only.
# Optional: without it, Fixture mode still works; Live mode is disabled.
GITHUB_TOKEN=

# LLM used for planning and evidence-grounded summaries.
# LLM_PROVIDER: anthropic | openai | none   (none = deterministic fallback, no key needed)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5

# Postgres (Supabase) in production; SQLite is used when empty.
# e.g. postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Commit SHA stamped on test-case records (CI/Render set this automatically).
GIT_SHA=

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
